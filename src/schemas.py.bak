"""
Structured data contracts shared across all agents.

Every LLM call in this system is forced to return one of these schemas
(via Pydantic + prompt-enforced JSON), so agent outputs are type-safe
and testable without depending on live model calls.
"""

from __future__ import annotations

from enum import Enum
from typing import List, Optional

from pydantic import BaseModel, Field


class RiskSeverity(str, Enum):
    LOW = "low"
    MEDIUM = "medium"
    HIGH = "high"
    CRITICAL = "critical"


class RevenueSignal(BaseModel):
    period: str = Field(..., description="Fiscal period, e.g. 'FY2025'")
    segment: str = Field(..., description="Business segment or 'Consolidated'")
    trend: str = Field(..., description="'growth', 'decline', or 'flat'")
    yoy_change_pct: Optional[float] = Field(
        None, description="Year-over-year % change, if stated or derivable"
    )
    note: str = Field(..., description="One-sentence explanation of the signal")


class DebtCovenant(BaseModel):
    covenant_type: str = Field(..., description="e.g. 'leverage ratio', 'interest coverage'")
    threshold: str = Field(..., description="The stated threshold or limit")
    current_status: str = Field(..., description="'compliant', 'at risk', or 'breached'")
    note: str


class LegalRisk(BaseModel):
    matter: str = Field(..., description="Short name of the legal/regulatory matter")
    severity: RiskSeverity
    potential_exposure: Optional[str] = Field(None, description="Stated financial exposure, if disclosed")
    note: str


class ExtractionResult(BaseModel):
    """Output of the Extraction Agent for a single filing."""

    company: str
    fiscal_year: str
    revenue_signals: List[RevenueSignal] = Field(default_factory=list)
    debt_covenants: List[DebtCovenant] = Field(default_factory=list)
    legal_risks: List[LegalRisk] = Field(default_factory=list)


class RiskFlag(BaseModel):
    category: str = Field(
        ...,
        description="'revenue', 'debt', 'legal', or 'market' (use 'market' for FX/interest-rate/"
        "commodity/operational risks that aren't a legal proceeding or a debt covenant - "
        "don't force these into 'legal' just because there's no better fit)",
    )
    severity: RiskSeverity
    headline: str
    detail: str


class SynthesisReport(BaseModel):
    """Final executive-level output of the Synthesis Agent."""

    company: str
    fiscal_year: str
    executive_summary: str
    top_risks: List[RiskFlag]
    recommendation: str = Field(
        ...,
        description="One-paragraph recommendation for M&A / portfolio decision-making",
    )
    confidence_score: float = Field(
        ...,
        ge=0.0,
        le=1.0,
        description="Model's self-assessed confidence in this recommendation (0-1). "
        "Drives the human-in-the-loop approval workflow: below the configured "
        "threshold, the report is routed to a human reviewer instead of "
        "auto-approved.",
    )


class ApprovalStatus(str, Enum):
    AUTO_APPROVED = "auto_approved"
    PENDING_REVIEW = "pending_review"
    APPROVED = "approved"
    REJECTED = "rejected"


class ReviewDecision(str, Enum):
    APPROVE = "approve"
    REJECT = "reject"


class ReviewSubmission(BaseModel):
    """A human reviewer's decision on a report routed for review."""

    reviewer: str = Field(..., description="Name or ID of the human reviewer")
    decision: ReviewDecision
    edited_recommendation: Optional[str] = Field(
        None, description="Reviewer's corrected recommendation, if they changed it"
    )
    notes: Optional[str] = Field(None, description="Reviewer's rationale, for the feedback record")


class RAGAnswer(BaseModel):
    question: str
    answer: str
    source_chunks: List[str] = Field(
        default_factory=list, description="IDs of the retrieved chunks used to answer"
    )


class TrendShift(BaseModel):
    """A single metric that changed materially between two filing periods."""

    metric: str = Field(..., description="e.g. 'Cloud Infrastructure revenue', 'leverage ratio'")
    prior_period: str
    current_period: str
    prior_value: str = Field(
        ..., min_length=1, description="Must be non-empty - a shift needs both endpoints stated"
    )
    current_value: str = Field(..., min_length=1, description="Must be non-empty - same reasoning")
    direction: str = Field(..., description="'improving', 'deteriorating', or 'stable'")
    materiality: RiskSeverity = Field(
        ..., description="How much this shift matters to the overall risk picture"
    )
    note: str


class ComparisonReport(BaseModel):
    """
    Output of the Comparison Agent: a year-over-year synthesis across
    two filings for the same company. This is a genuinely harder problem
    than single-filing synthesis because it requires reconciling two
    independent extractions - aligning metrics across periods, not just
    summarizing one.
    """

    company: str
    prior_fiscal_year: str
    current_fiscal_year: str
    trend_shifts: List[TrendShift]
    overall_trajectory: str = Field(..., description="'improving', 'deteriorating', or 'mixed'")
    narrative: str = Field(..., description="Executive-level narrative of what changed and why it matters")


class CheckResult(BaseModel):
    """A single pass/fail check comparing extraction output to ground truth."""

    check_name: str
    passed: bool
    expected: str
    actual: str


class EvaluationResult(BaseModel):
    """
    Result of running the evaluation harness against one filing's
    ground-truth labels. Distinct from ExtractionResult: this measures
    whether the extraction was *correct*, not what it extracted.
    """

    filing: str
    checks: List[CheckResult]
    passed_count: int
    total_count: int
    accuracy: float = Field(..., description="passed_count / total_count")


class CompanyRank(BaseModel):
    """One company's position in a single portfolio ranking dimension."""

    company: str
    rank: int
    metric_value: float = Field(..., description="The underlying number this ranking is sorted by")
    metric_label: str = Field(..., description="Human-readable description of what metric_value represents")
    data_available: bool = Field(
        True,
        description="False if extraction found no data for this metric at all - distinguishes "
        "'genuinely flat/zero' from 'nothing was extracted', which both default to 0.0 "
        "otherwise and are easy to confuse in a ranking display.",
    )


class PortfolioReport(BaseModel):
    """
    Cross-company portfolio intelligence: rankings across growth, risk,
    and debt exposure, plus a sector-level narrative. This is what turns
    the system from "analyzes one filing" into "portfolio-level
    intelligence" - the rankings themselves are computed deterministically
    from each company's ExtractionResult (see src/portfolio_agent.py), not
    re-derived by an LLM call, so they're reproducible and auditable;
    the narrative synthesis is the one LLM-generated part.
    """

    companies: List[str]
    growth_ranking: List[CompanyRank] = Field(
        ..., description="Ranked by average revenue YoY % change, highest first"
    )
    risk_ranking: List[CompanyRank] = Field(
        ..., description="Ranked by legal/regulatory risk severity, highest risk first"
    )
    debt_ranking: List[CompanyRank] = Field(
        ..., description="Ranked by count of non-compliant debt covenants, highest first"
    )
    sector_narrative: str = Field(..., description="Executive-level synthesis of cross-company trends")


class SectorNarrative(BaseModel):
    """The one LLM-generated field of a PortfolioReport - requested separately
    from the deterministic rankings so an LLM call can't alter the rankings."""

    sector_narrative: str


class QualityReport(BaseModel):
    """
    Structural data-quality assessment for a LIVE extraction/synthesis run
    (real ticker, no ground truth available) - NOT an accuracy score.

    There is no hand-labeled ground truth for a real company's filing, so
    this system cannot honestly report "94.2% extraction accuracy" or a
    "hallucination rate" for a live ticker the way it can for the bundled
    synthetic sample filings (see evaluation.py, which DOES have ground
    truth and computes real accuracy - only for Nimbus/Solara/Vantage).
    This report instead measures what's actually knowable without ground
    truth: are required fields populated, do detected values pass
    structural sanity checks (e.g. unit consistency), does the company/
    fiscal_year match what was requested.
    """

    company: str
    fiscal_year: str
    completeness_score: float = Field(
        ..., ge=0.0, le=1.0, description="Fraction of expected fields that are non-empty"
    )
    error_count: int
    warning_count: int
    issues: List[str] = Field(default_factory=list)
