# Set LLM_MODE=live to use real Gemini calls; default is "mock" (no key needed)
LLM_MODE=mock
GEMINI_API_KEY=your-gemini-api-key-here

# Comma-separated API keys accepted by the /analyze, /compare, /ask, /evaluate endpoints
API_KEYS=change-me-in-production

# Requests per minute allowed per client IP
RATE_LIMIT_PER_MINUTE=30

LOG_LEVEL=INFO
